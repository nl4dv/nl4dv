#!/usr/bin/env bash
# Runs during Heroku Python buildpack compile (after pip install).

set -euo pipefail

# Newer NLTK blocks some imports when the app root is on sys.path (Heroku build dir).
export NLTK_DISABLE_IMPORT_SECURITY=1
export PYTHONSAFEPATH=1

# IMPORTANT: during compile, cwd is the build dir that becomes /app at runtime.
# Writing to absolute /app/... here does NOT end up in the slug.
NLTK_DATA_DIR="$(pwd)/nltk_data"
mkdir -p "$NLTK_DATA_DIR"
export NLTK_DATA="$NLTK_DATA_DIR"

echo "-----> Downloading spaCy model en_core_web_sm"
python -m spacy download en_core_web_sm

# popular includes punkt/stopwords/wordnet, but NLTK 3.8.2+/3.9+ word_tokenize
# needs punkt_tab (and pos_tag needs averaged_perceptron_tagger_eng).
echo "-----> Downloading NLTK corpora into $NLTK_DATA_DIR"
python -m nltk.downloader -d "$NLTK_DATA_DIR" popular punkt_tab averaged_perceptron_tagger_eng

# Fail the build early if tokenization still can't load.
python - <<'PY'
import os
import nltk
from nltk.corpus import stopwords
from nltk import word_tokenize

nltk.data.path.insert(0, os.environ["NLTK_DATA"])
words = stopwords.words("english")
tokens = word_tokenize("Show average budget by genre")
print(f"-----> NLTK OK (stopwords={len(words)}, tokenize={tokens}) at {os.environ['NLTK_DATA']}")
PY
